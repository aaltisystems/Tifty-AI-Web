# ---------------------------------------------------------------------------
# Rewrites: HTTPS enforcement, canonical host, dotfile blocking
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    # mod_rewrite refuses RewriteRule in .htaccess unless one of these is on.
    # -Indexes also stops directory listings (e.g. /logo/).
    Options -Indexes +FollowSymLinks

    RewriteEngine On

    # Block dotfiles and dot-directories (.git, .env, .agents, .claude) that end
    # up in the deploy root. ACME challenges under /.well-known/ stay reachable.
    RewriteRule "(^|/)\.(?!well-known/)" - [F,L]

    # Force HTTPS on the canonical host only.
    # %{HTTPS} alone is not enough: behind a TLS-terminating proxy (Cloudflare,
    # Hostinger's edge) it reads "off" even for HTTPS requests, and a 301 back to
    # the same URL then loops forever — and 301s stick in browser caches.
    # Non-canonical hosts (staging/preview domains) are deliberately left alone.
    RewriteCond %{HTTP_HOST} ^(www\.)?tiftyai\.com$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https [NC]
    RewriteRule ^ https://tiftyai.com%{REQUEST_URI} [L,R=301]

    # www -> apex, matching rel=canonical / og:url / JSON-LD in index.html.
    # The target host is hard-coded rather than echoed from %{HTTP_HOST}, so a
    # poisoned Host header cannot turn this into an open redirect.
    RewriteCond %{HTTP_HOST} ^www\.tiftyai\.com$ [NC]
    RewriteRule ^ https://tiftyai.com%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------------------------------------------------------------------------
# Deny source and config files that ship alongside the site
# ---------------------------------------------------------------------------
# Covers .env.example, env.js.example, *.md, tsconfig.json, types.d.ts,
# skills-lock.json and components/ui/*.tsx. Add an exception here if the site
# ever needs to serve a .json (e.g. a web app manifest).
<FilesMatch "^\.|\.(example|md|json|sql|log|bak|ini|sh|ts|tsx|yml|yaml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------------
# X-Frame-Options and CSP frame-ancestors are ignored by browsers when they are
# delivered in a <meta> tag (as index.html does), so they only take effect here.
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

    # Framing policy only. The full CSP stays in index.html's <meta>; both are
    # enforced, so keep this one narrow to avoid intersecting the two.
    Header always set Content-Security-Policy "frame-ancestors 'none'"

    # Backs up the redirect above. Browsers ignore it over plain HTTP.
    # No includeSubDomains / preload, so it is reversible: drop this line and the
    # pin expires within a year (or set max-age=0 to clear it immediately).
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# ---------------------------------------------------------------------------
# Browser caching
# ---------------------------------------------------------------------------
# Nothing in this project is content-hashed or version-queried, so no asset gets
# a lifetime a deploy cannot outlive. HTML/CSS/JS revalidate on every visit
# (cheap 304s) — otherwise a returning visitor keeps stale app.js/style.css, and
# a rotated Supabase key in env.js never reaches them. Once assets carry a ?v=
# or a content hash, these three can move to "access plus 1 year".
<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 0 seconds"
    ExpiresByType text/javascript "access plus 0 seconds"
    ExpiresByType text/x-javascript "access plus 0 seconds"

    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"

    # videoTifty.mp4 is 21 MB — by far the largest asset and the one the old
    # rules skipped entirely.
    ExpiresByType video/mp4 "access plus 1 month"
</IfModule>

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    # Apache 2.4.54+ and LiteSpeed serve .js as text/javascript, so without this
    # line app.js and translations.js (53 KB together) ship uncompressed.
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript

    <IfModule mod_headers.c>
        Header append Vary Accept-Encoding
    </IfModule>
</IfModule>
